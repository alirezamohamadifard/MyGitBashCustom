<Window x:Class="MyGitBashCustom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:MyGitBashCustom.Helpers"
        xmlns:views="clr-namespace:MyGitBashCustom.Views"
        Title="ترمینال فارسی Git Bash" Height="800" Width="1240" MinHeight="640" MinWidth="1000"
        FlowDirection="RightToLeft" Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding Terminals.AddTabCommand}"/>
    <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding Terminals.CloseTabCommand}"/>
    <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding Terminals.NextTabCommand}"/>
    <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding Terminals.PrevTabCommand}"/>
  </Window.InputBindings>
  <Window.Resources>
    <h:BoolToVis x:Key="B2V"/>
    <h:InvBoolToVis x:Key="IB2V"/>
    <h:CountBarWidth x:Key="BarW"/>
    <h:CountBarHeight x:Key="BarH"/>
    <h:LevelBrush x:Key="LvlB"/>
    <h:StringToVis x:Key="StrVis"/>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <Style x:Key="SettingsGroup" TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupBox">
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource Fg}"
                                  TextElement.FontSize="14" TextElement.FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ContentPresenter Grid.Row="1"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ═══ نوار بالا ═══ -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,10,0">
            <Image Source="Assets/MyGitBashCustom.png" Width="34" Height="34" Stretch="Uniform"/>
          </Border>
          <StackPanel>
            <TextBlock Text="ترمینال فارسی Git Bash" Foreground="{StaticResource Fg}" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding Versions}" Foreground="{StaticResource Muted}" FontSize="11" FlowDirection="LeftToRight"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
          <TextBlock Text="{Binding BashStatus}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
          <ProgressBar Value="{Binding InstallProgress}" Maximum="100" Height="5" Margin="0,5,0,0"
                       Visibility="{Binding Installing, Converter={StaticResource BoolVis}}" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="⟳ بررسی مجدد" Style="{StaticResource GhostBtn}" Command="{Binding StartCommand}" Margin="0,0,8,0"/>
          <Button Content="⬇ نصب Git Bash" Style="{StaticResource AccentBtn}" Command="{Binding InstallCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="208"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ═══ سایدبار ═══ -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="10">
        <StackPanel>
          <Button Content="⌨  ترمینال‌ها" Style="{StaticResource NavBtn}" Command="{Binding GoTabCommand}" CommandParameter="0"/>
          <Button Content="📚  مرجع دستورات" Style="{StaticResource NavBtn}" Command="{Binding GoTabCommand}" CommandParameter="1"/>
          <Button Content="⭐  پُراستفاده‌ها" Style="{StaticResource NavBtn}" Command="{Binding GoTabCommand}" CommandParameter="2"/>
          <Button Content="📊  عملکرد من" Style="{StaticResource NavBtn}" Command="{Binding GoTabCommand}" CommandParameter="3"/>
          <Button Content="🧾  لاگ‌های سیستم" Style="{StaticResource NavBtn}" Command="{Binding GoTabCommand}" CommandParameter="4"/>
          <Button Content="⚙  تنظیمات" Style="{StaticResource NavBtn}" Command="{Binding GoTabCommand}" CommandParameter="5"/>
          <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="10" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="⭐ محبوب‌ترین" Foreground="{StaticResource Muted}" FontSize="11"/>
              <TextBlock Text="{Binding Stats.Favorite}" Foreground="{StaticResource Accent}" FontSize="13" FontWeight="Bold" FlowDirection="LeftToRight" Margin="0,2"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11">
                <Run Text="مجموع اجراها: "/><Run Text="{Binding Stats.Total}"/>
              </TextBlock>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="10" Margin="0,8,0,0">
            <StackPanel>
              <TextBlock Text="💡 نکته" Foreground="{StaticResource Muted}" FontSize="11"/>
              <TextBlock Text="با Tab پیشنهاد را بپذیرید، با ↑ تاریخچه را مرور کنید." Foreground="{StaticResource Fg}" FontSize="11.5" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ═══ محتوا ═══ -->
      <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" Padding="14" Background="Transparent" BorderThickness="0">
        <TabControl.Resources>
          <Style TargetType="TabPanel"><Setter Property="Visibility" Value="Collapsed"/></Style>
        </TabControl.Resources>

        <!-- ── ۰ ترمینال‌ها (تب بی‌نهایت) ── -->
        <TabItem>
          <Grid DataContext="{Binding Terminals}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="＋ تب جدید" Style="{StaticResource AccentBtn}" Command="{Binding AddTabCommand}" Padding="14,6"/>
              <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"
                         Text="میانبرها: Ctrl+T تب جدید • Ctrl+W بستن • Ctrl+Tab جابه‌جایی • دابل‌کلیک روی نام تب = تغییر نام • هر تب موتور Bash مستقل دارد"/>
            </StackPanel>
            <TabControl Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                        Background="Transparent" BorderThickness="0" Padding="0,4,0,0">
              <TabControl.Resources>
                <Style TargetType="TabPanel"><Setter Property="Visibility" Value="Visible"/></Style>
              </TabControl.Resources>
              <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                  <EventSetter Event="MouseDoubleClick" Handler="TabHeader_DoubleClick"/>
                  <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="9,9,0,0" Padding="10,7" Margin="2,0">
                          <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/>
                          </Trigger>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource Panel2}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </TabControl.ItemContainerStyle>
              <TabControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}"
                              ToolTip="{Binding Cwd}">
                    <TextBlock Text="⏳" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource B2V}}"/>
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource Fg}" FontSize="12.5" VerticalAlignment="Center" Margin="4,0"/>
                    <Border Background="{StaticResource Panel}" CornerRadius="5" Padding="6,0" Margin="4,0,0,0"
                            Visibility="{Binding GitBranch, Converter={StaticResource StrVis}}">
                      <TextBlock Text="{Binding GitBranch}" Foreground="{StaticResource Green}" FontSize="10" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="×" FontSize="12" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="بستن تب (Ctrl+W)"
                            Command="{Binding Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                            CommandParameter="{Binding}">
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Background" Value="Transparent"/>
                          <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                          <Setter Property="BorderThickness" Value="0"/>
                          <Setter Property="Cursor" Value="Hand"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="Background" Value="#3A2020"/>
                              <Setter Property="Foreground" Value="#F85149"/>
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <StackPanel.ContextMenu>
                      <ContextMenu FlowDirection="RightToLeft"
                                   DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="＋ تب جدید" Command="{Binding AddTabCommand}"/>
                        <MenuItem Header="⧉ تکثیر این تب" Command="{Binding DuplicateTabCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="✏ تغییر نام تب" Command="{Binding RenameTabCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="✕ بستن این تب" Command="{Binding CloseTabCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="بستن بقیه تب‌ها" Command="{Binding CloseOthersCommand}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                      </ContextMenu>
                    </StackPanel.ContextMenu>
                  </StackPanel>
                </DataTemplate>
              </TabControl.ItemTemplate>
              <TabControl.ContentTemplate>
                <DataTemplate>
                  <views:TerminalView Margin="0,4,0,0"/>
                </DataTemplate>
              </TabControl.ContentTemplate>
            </TabControl>
          </Grid>
        </TabItem>

        <!-- ── ۱ مرجع دستورات ── -->
        <TabItem>
          <Grid DataContext="{Binding Commands}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="📚 مرجع کامل دستورات Git و Bash" Foreground="{StaticResource Fg}" FontSize="18" FontWeight="Bold"/>
            <Grid Grid.Row="1" Margin="0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="170"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0">
                <TextBox.Style>
                  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </TextBox.Style>
              </TextBox>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}"/>
            </Grid>
            <ListBox Grid.Row="2" ItemsSource="{Binding Filtered}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="14" FontFamily="Consolas" FlowDirection="LeftToRight"/>
                        <Border Background="{StaticResource Panel2}" CornerRadius="6" Padding="7,1" Margin="8,0,0,0">
                          <TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding DescriptionFa}" Foreground="{StaticResource Fg}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding DescriptionEn}" Foreground="{StaticResource Muted}" FontSize="11" FontStyle="Italic" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                      <Border Background="#0A0E14" CornerRadius="7" Padding="8,6" Margin="0,7,0,0">
                        <TextBlock Text="{Binding Syntax}" Foreground="{StaticResource Cyan}" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
                      </Border>
                      <TextBlock Foreground="{StaticResource Green}" FontFamily="Consolas" FontSize="11.5" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,4,0,0" Text="{Binding Example}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="📋 سینتکس" Style="{StaticResource GhostBtn}" Command="{Binding DataContext.CopySyntaxCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,6,0"/>
                        <Button Content="📋 مثال" Style="{StaticResource GhostBtn}" Command="{Binding DataContext.CopyExampleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,6,0"/>
                        <Button Content="⏎ ارسال به ترمینال" Style="{StaticResource AccentBtn}" Command="{Binding DataContext.SendCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Padding="12,5"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <!-- ── ۲ پُراستفاده‌ها ── -->
        <TabItem>
          <Grid DataContext="{Binding Stats}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⭐ پُراستفاده‌ترین دستورات شما" Foreground="{StaticResource Fg}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Content="⟳ به‌روزرسانی" Style="{StaticResource GhostBtn}" Command="{Binding RefreshCommand}" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12">
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,0" MinWidth="170">
                <StackPanel>
                  <TextBlock Text="مجموع اجراها" Foreground="{StaticResource Muted}" FontSize="11"/>
                  <TextBlock Text="{Binding Total}" Foreground="{StaticResource Fg}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16,12" MinWidth="220">
                <StackPanel>
                  <TextBlock Text="محبوب‌ترین" Foreground="{StaticResource Muted}" FontSize="11"/>
                  <TextBlock Text="{Binding Favorite}" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding Top}" Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,7">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Command}" Foreground="{StaticResource Cyan}" FontFamily="Consolas" FontSize="13.5" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                        <Border Background="{StaticResource Panel2}" CornerRadius="5" Height="10">
                          <Border Background="{StaticResource Green}" CornerRadius="5" HorizontalAlignment="Right"
                                  Width="{Binding Count, Converter={StaticResource BarW}}"/>
                        </Border>
                        <TextBlock Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,3,0,0">
                          <Run Text="×"/><Run Text="{Binding Count}"/><Run Text="  •  موفق: "/><Run Text="{Binding SuccessRate, StringFormat={}{0:0}%}"/>
                          <Run Text="  •  میانگین: "/><Run Text="{Binding AvgMs, StringFormat={}{0:0}ms}"/>
                        </TextBlock>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding LastUsed, StringFormat={}{0:MM/dd HH:mm}}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <!-- ── ۳ عملکرد ── -->
        <TabItem>
          <Grid DataContext="{Binding Activity}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="📊 عملکرد شما" Foreground="{StaticResource Fg}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
              <ComboBox Width="130" Margin="12,0,0,0" SelectedIndex="1" x:Name="RangeBox">
                <ComboBoxItem Content="۷ روز"/>
                <ComboBoxItem Content="۳۰ روز"/>
                <ComboBoxItem Content="۹۰ روز"/>
              </ComboBox>
              <Button Content="⟳ بارگذاری" Style="{StaticResource GhostBtn}" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,10" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,0,10,0" MinWidth="140">
                <StackPanel><TextBlock Text="مجموع" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Total}" Foreground="{StaticResource Fg}" FontSize="22" FontWeight="Bold"/></StackPanel>
              </Border>
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16,10" Margin="0,0,10,0" MinWidth="140">
                <StackPanel><TextBlock Text="نرخ موفقیت" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding SuccessRate, StringFormat={}{0:0}%}" Foreground="{StaticResource Green}" FontSize="22" FontWeight="Bold"/></StackPanel>
              </Border>
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16,10" MinWidth="140">
                <StackPanel><TextBlock Text="پیک روزانه" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding MaxDay}" Foreground="{StaticResource Accent}" FontSize="22" FontWeight="Bold"/></StackPanel>
              </Border>
            </StackPanel>
            <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="14">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Days}" FlowDirection="LeftToRight">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Width="44" VerticalAlignment="Bottom" Margin="3,0" ToolTip="{Binding Count}">
                        <TextBlock Text="{Binding Count}" Foreground="{StaticResource Fg}" FontSize="10" HorizontalAlignment="Center"/>
                        <Border Background="{StaticResource Accent}" CornerRadius="4,4,0,0" Height="{Binding Count, Converter={StaticResource BarH}}" MinHeight="4" Margin="6,4,6,0" VerticalAlignment="Bottom"/>
                        <TextBlock Text="{Binding Day, StringFormat={}{0:MM/dd}}" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>

        <!-- ── ۴ لاگ‌ها ── -->
        <TabItem>
          <Grid DataContext="{Binding Logs}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🧾 لاگ‌های سیستم" Foreground="{StaticResource Fg}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Content="📤 خروجی" Style="{StaticResource GhostBtn}" Command="{Binding ExportCommand}" Margin="12,0,0,0"/>
              <Button Content="🧹 پاک‌کردن نما" Style="{StaticResource GhostBtn}" Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="150"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level, Mode=TwoWay}"/>
            </Grid>
            <ListBox Grid.Row="2" ItemsSource="{Binding Filtered}" Background="#0A0E14" BorderBrush="{StaticResource Border}" BorderThickness="1"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" FlowDirection="LeftToRight">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="6,3">
                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border CornerRadius="5" Padding="7,1" Margin="0,0,8,0" Background="{Binding Level, Converter={StaticResource LvlB}}">
                      <TextBlock Text="{Binding Level}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <StackPanel>
                      <TextBlock Foreground="#E6EDF3" FontSize="12" TextWrapping="Wrap">
                        <Run Text="[" Foreground="{StaticResource Muted}"/><Run Text="{Binding Source}" Foreground="{StaticResource Cyan}"/><Run Text="] " Foreground="{StaticResource Muted}"/><Run Text="{Binding Message}"/>
                      </TextBlock>
                      <TextBlock Text="{Binding Exception}" Foreground="{StaticResource Red}" FontSize="10.5" TextWrapping="Wrap"
                                 Visibility="{Binding Exception, Converter={StaticResource StrVis}}"/>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <!-- ── ۵ تنظیمات ── -->
        <TabItem>
          <ScrollViewer DataContext="{Binding SettingsVm}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Stretch" Margin="4,0,10,16">
              <TextBlock Text="تنظیمات و شخصی‌سازی" Foreground="{StaticResource Fg}" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="تغییرات این صفحه بلافاصله اعمال و به‌صورت خودکار ذخیره می‌شوند."
                         Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,5,0,0"/>
              <Border Background="#183525" CornerRadius="8" Padding="10,6" Margin="0,8,0,12"
                      Visibility="{Binding SaveNote, Converter={StaticResource StrVis}}">
                <TextBlock Text="{Binding SaveNote}" Foreground="#69DB91" FontSize="11.5"/>
              </Border>
              <GroupBox Header="ظاهر" Style="{StaticResource SettingsGroup}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="تم:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" Margin="0,0,12,8"/>
                  <TextBlock Grid.Column="2" Text="رنگ تأکیدی:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="3" ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent, Mode=TwoWay}" Margin="0,0,0,8"/>
                  <TextBlock Grid.Row="1" Text="فونت:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Fonts}" SelectedItem="{Binding FontFamily, Mode=TwoWay}" Margin="0,0,12,0"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="اندازه فونت:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                    <Slider Value="{Binding FontSize, Mode=TwoWay}" Minimum="10" Maximum="22" Width="110" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FontSize, StringFormat={}{0:0}}" Foreground="{StaticResource Fg}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </GroupBox>
              <GroupBox Header="ترمینال و ورودی" Style="{StaticResource SettingsGroup}">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="نماد پرامپت:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" FlowDirection="LeftToRight"/>
                  </Grid>
                  <CheckBox Content="رنگ‌بندی نحوی هنگام تایپ" IsChecked="{Binding Highlight, Mode=TwoWay}" Foreground="{StaticResource Fg}" Margin="0,4"/>
                  <CheckBox Content="اینتلیسنس هوشمند" IsChecked="{Binding Intel, Mode=TwoWay}" Foreground="{StaticResource Fg}" Margin="0,4"/>
                  <CheckBox Content="ذخیره تاریخچه" IsChecked="{Binding SaveHistory, Mode=TwoWay}" Foreground="{StaticResource Fg}" Margin="0,4"/>
                  <CheckBox Content="نمایش خوش‌آمد" IsChecked="{Binding ShowWelcome, Mode=TwoWay}" Foreground="{StaticResource Fg}" Margin="0,4"/>
                  <CheckBox Content="شروع تمام‌صفحه" IsChecked="{Binding StartMaximized, Mode=TwoWay}" Foreground="{StaticResource Fg}" Margin="0,4"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="هستهٔ Git Bash" Style="{StaticResource SettingsGroup}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding BashPath, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                    <Button Grid.Column="1" Content="📁 انتخاب…" Style="{StaticResource GhostBtn}" Command="{Binding BrowseCommand}" Margin="8,0,0,0"/>
                  </Grid>
                  <CheckBox Content="بررسی خودکار هنگام شروع" IsChecked="{Binding AutoCheck, Mode=TwoWay}" Foreground="{StaticResource Fg}" Margin="0,8,0,0"/>
                  <CheckBox Content="قبل از دانلود/نصب اجازه بگیر" IsChecked="{Binding ConfirmBeforeInstall, Mode=TwoWay}" Foreground="{StaticResource Fg}" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding EngineState}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="محل ذخیرهٔ داده‌ها و لاگ‌ها" Style="{StaticResource SettingsGroup}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="محل ذخیره:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataLocations}" SelectedItem="{Binding DataLocation, Mode=TwoWay}"/>
                  </Grid>
                  <Grid Margin="0,8,0,0" Visibility="{Binding IsCustomData, Converter={StaticResource BoolVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding CustomDataPath, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                    <Button Grid.Column="1" Content="📁…" Style="{StaticResource GhostBtn}" Command="{Binding BrowseDataCommand}" Margin="8,0,0,0"/>
                  </Grid>
                  <TextBlock Text="{Binding CurrentDataRoot}" Foreground="{StaticResource Muted}" FontSize="11" FlowDirection="LeftToRight" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  <TextBlock Text="خودکار = پوشه data کنار برنامه؛ اگر قابل‌نوشتن نباشد AppData. تغییر محل پس از راه‌اندازی مجدد اعمال و داده‌ها منتقل می‌شوند."
                             Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="مدیریت داده‌ها" Style="{StaticResource SettingsGroup}">
                <StackPanel>
                  <TextBlock Text="{Binding DataFolder}" Foreground="{StaticResource Muted}" FontSize="11" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="📂 بازکردن پوشه داده" Style="{StaticResource GhostBtn}" Click="OpenData_Click" Margin="0,0,8,0"/>
                    <Button Content="↺ بازنشانی تنظیمات" Style="{StaticResource GhostBtn}" Command="{Binding ResetCommand}"/>
                  </StackPanel>
                </StackPanel>
              </GroupBox>
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                      CornerRadius="12" Padding="16" Margin="0,12,0,20">
                <StackPanel>
                  <TextBlock Text="دربارهٔ ترمینال فارسی Git Bash" Foreground="{StaticResource Fg}" FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Margin="0,7,0,0" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" LineHeight="21"
                             Text="یک محیط یکپارچه و فارسی برای کار روزمره با Git Bash؛ با ترمینال‌های مستقل، پیشنهاد هوشمند، رنگ‌بندی نحوی، تاریخچه، آمار و گزارش‌های کاربردی. هدف پروژه این است که تجربهٔ خط فرمان برای کاربران فارسی‌زبان سریع، خوانا و قابل‌اعتماد باشد."/>
                  <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Fg}" FontSize="12.5" TextWrapping="Wrap">
                    <Run Text="پیشنهاد، انتقاد یا گزارش خطا دارید؟ با افتخار می‌شنویم: "/>
                    <Hyperlink NavigateUri="mailto:realmadrid121925@outlook.com" RequestNavigate="SupportEmail_RequestNavigate"
                               Foreground="{StaticResource Accent}" TextDecorations="None">realmadrid121925@outlook.com</Hyperlink>
                  </TextBlock>
                  <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="11"
                             Text="برای گزارش خطا، لطفاً مراحل بازتولید و بخش مرتبط از لاگ سیستم را هم ارسال کنید."/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- ═══ نوار وضعیت ═══ -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,7">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,14,0" FlowDirection="LeftToRight" Text="{Binding Terminals.Selected.Cwd}"/>
          <Border Background="{StaticResource Panel2}" CornerRadius="6" Padding="8,1" Visibility="{Binding Terminals.Selected.GitBranch, Converter={StaticResource StrVis}}">
            <TextBlock Foreground="{StaticResource Green}" FontSize="11" FlowDirection="LeftToRight" Text="{Binding Terminals.Selected.GitBranch, StringFormat=🌿 {0}}"/>
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="11.5" Text="MyGitBashCustom v1.2"/>
      </Grid>
    </Border>
  </Grid>
</Window>
