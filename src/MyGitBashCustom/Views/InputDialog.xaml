<Window x:Class="MyGitBashCustom.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ورودی" Height="190" Width="380" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="{StaticResource Panel}"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock x:Name="Lbl" Foreground="{StaticResource Fg}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
    <TextBox x:Name="Box" FlowDirection="RightToLeft" FontSize="14"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
      <Button Content="تأیید" Style="{StaticResource AccentBtn}" Click="Ok_Click" MinWidth="90" Margin="0,0,8,0"/>
      <Button Content="انصراف" Style="{StaticResource GhostBtn}" Click="Cancel_Click" MinWidth="90"/>
    </StackPanel>
  </StackPanel>
</Window>
